# FarmLedger Pro environment configuration
# Copy to .env or export these variables for deployment.

# Required for production
DJANGO_SECRET_KEY=          # generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=0              # 0 in production, 1 (default) for local development
DJANGO_ALLOWED_HOSTS=farmledger.example.com,www.farmledger.example.com
DJANGO_ALLOWED_HOSTS_ANY=0  # 1 only for development convenience

# HTTPS / cookies (default: enabled automatically when DJANGO_DEBUG=0)
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_BEHIND_PROXY=0     # set 1 when behind a TLS-terminating proxy

# Database (defaults to SQLite for development)
# FARMLEDGER_USE_SQLITE=0   # set 0 to use PostgreSQL below
# POSTGRES_DB=farmledger
# POSTGRES_USER=farmledger_user
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Celery / Redis
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@farmledger.pro

# CORS (allow-all defaults to DEBUG only)
# CORS_ALLOW_ALL_ORIGINS=0
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Optional S3 media storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=farmledger-media
# AWS_S3_REGION_NAME=us-east-1
